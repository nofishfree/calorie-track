# Database
DATABASE_URL=postgresql://username:password@localhost/calorie_track
# JWT Secret（必填，至少 32 个字符；生成方式：openssl rand -base64 48）
JWT_SECRET=
# 允许的跨域来源（逗号分隔，必须包含前端部署域名；未配置时仅允许本地开发地址）
CORS_ALLOWED_ORIGINS=https://nutrition-tracker.fishfree.fun,http://localhost:5173,http://127.0.0.1:5173
# 仅本地开发：将密码重置验证码输出到服务端日志（生产环境不要开启）
PASSWORD_RESET_CODE_LOG=false
# Server
HOST=0.0.0.0
PORT=3000
